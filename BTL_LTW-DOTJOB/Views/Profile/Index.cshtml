@model BTL_LTW_DOTJOB.ViewModels.Profile.ProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";

    var isEmployer = Model.Role == "Employer";
    var roleLabel = Model.Role switch
    {
        "Admin" => "Quản trị viên",
        "Employer" => "Nhà tuyển dụng",
        _ => "Ứng viên"
    };
    var initial = Model.FullName.Trim().Length > 0 ? char.ToUpper(Model.FullName.Trim()[0]).ToString() : "U";

    var shortName = Model.CompanyName is { Length: > 0 } cName 
        ? cName[..Math.Min(3, cName.Length)].ToUpper() 
        : "JOB";
    bool hasLogo = !string.IsNullOrEmpty(Model.LogoPath);

}

<div style="background-color: #f4f5f5;" class="py-4">
    <div class="container" style="max-width: 1100px;">

        <h4 class="fw-bold text-dark border-start border-success border-4 ps-3 mb-3">Hồ sơ cá nhân</h4>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success border-0 shadow-sm rounded-3"><i class="fa-solid fa-circle-check me-2"></i>@successMessage</div>
        }

        <div class="row g-4">

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
                    @if (!string.IsNullOrEmpty(Model.AvatarPath))
                    {
                        <img src="@Model.AvatarPath" alt="Avatar" id="avatarPreview" class="rounded-circle mx-auto mb-3 object-fit-cover"
                             style="width: 120px; height: 120px;">
                    }
                    else
                    {
                        <div id="avatarPlaceholder" class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center fw-bold mx-auto mb-3"
                             style="width: 120px; height: 120px; font-size: 3rem;">@initial</div>
                        <img src="" alt="Avatar" id="avatarPreview" class="rounded-circle mx-auto mb-3 object-fit-cover d-none"
                             style="width: 120px; height: 120px;">
                    }
                    <h5 class="fw-bold mb-1">@Model.FullName</h5>
                    <div class="mb-2"><span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">@roleLabel</span></div>
                    <div class="text-muted small"><i class="fa-regular fa-envelope me-1"></i>@Model.Email</div>
                </div>
            </div>

            <div class="col-lg-8">

                <form asp-controller="Profile" asp-action="Update" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3"></div>

                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                        <h6 class="fw-bold mb-3"><i class="fa-regular fa-user text-success me-2"></i>Thông tin cá nhân</h6>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label">Họ và tên</label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">Số điện thoại</label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <input value="@Model.Email" class="form-control" disabled />
                                <div class="form-text">Email dùng để đăng nhập nên không thể thay đổi.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Vai trò</label>
                                <input value="@roleLabel" class="form-control" disabled />
                            </div>
                            <div class="col-12">
                                <label asp-for="AvatarFile" class="form-label">Ảnh đại diện</label>
                                <input asp-for="AvatarFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                                <div class="form-text">Chọn ảnh rồi căn chỉnh trong hộp thoại hiện ra. Ảnh sau khi cắt sẽ được lưu khi bạn bấm "Lưu thay đổi".</div>
                            </div>
                        </div>
                    </div>

                    @if (isEmployer)
                    {
                        var locations = BTL_LTW_DOTJOB.Areas.Employer.ViewModels.JobOptions.Locations.ToList();
                        if (!string.IsNullOrEmpty(Model.WorkLocation) && !locations.Contains(Model.WorkLocation))
                        {
                            locations.Add(Model.WorkLocation);
                        }

                        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                            <h6 class="fw-bold mb-3"><i class="fa-regular fa-building text-success me-2"></i>Thông tin công ty</h6>

                            <div class="row g-3">
                                <div class="col-12">
                                    <label asp-for="CompanyName" class="form-label">Tên công ty</label>
                                    <input asp-for="CompanyName" class="form-control" />
                                    <span asp-validation-for="CompanyName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="WorkLocation" class="form-label">Khu vực làm việc</label>
                                    <select asp-for="WorkLocation" class="form-select">
                                        <option value="">-- Chọn khu vực --</option>
                                        @foreach (var location in locations)
                                        {
                                            <option value="@location">@location</option>
                                        }
                                    </select>
                                    <span asp-validation-for="WorkLocation" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Website" class="form-label">Website</label>
                                    <input asp-for="Website" class="form-control" placeholder="https://..." />
                                    <span asp-validation-for="Website" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="CompanyAddress" class="form-label">Địa chỉ công ty</label>
                                    <input asp-for="CompanyAddress" class="form-control" />
                                    <span asp-validation-for="CompanyAddress" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Description" class="form-label">Giới thiệu công ty</label>
                                    <textarea asp-for="Description" rows="6" class="form-control rich-editor"></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>


                                <div class="mb-3">
                                    <label asp-for="LogoFile" class="form-label fw-bold">Logo công ty</label>

                                    <div class="mb-2">
                                        <img id="logoPreview"
                                             src="@Model.LogoPath"
                                             alt="Logo"
                                             class="border rounded-3 shadow-sm @(hasLogo ? "" : "d-none")"
                                             style="width: 100px; height: 100px; object-fit: contain; padding: 4px; background: #fff; margin-left: 280px"
                                             onerror="this.classList.add('d-none'); document.getElementById('logoPlaceholder').style.display='grid'; document.getElementById('logoPlaceholder').classList.remove('d-none');" />

                                        <div id="logoPlaceholder"
                                             class="border rounded-3 shadow-sm bg-light @(hasLogo ? "d-none" : "")"
                                             style="width: 100px; height: 100px; display: @(hasLogo ? "none" : "grid"); place-items: center ; margin-left: 280px">
                                            <span class="text-primary fw-bold" style="font-size: 1.35rem; line-height: 1; letter-spacing: 1px;">@shortName</span>
                                        </div>
                                    </div>

                                    <input asp-for="LogoFile" type="file" class="form-control" accept=".jpg,.jpeg,.png">
                                    <div class="form-text text-muted">JPG hoặc PNG, tối đa 2MB.</div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="text-end mb-4">
                        <button type="submit" class="btn btn-success rounded-3 px-4 fw-bold">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>

                <form asp-controller="Profile" asp-action="ChangePassword" method="post">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h6 class="fw-bold mb-3"><i class="fa-solid fa-lock text-success me-2"></i>Đổi mật khẩu</h6>

                        @if (TempData["PasswordError"] is string passwordError)
                        {
                            <div class="alert alert-danger border-0 rounded-3 py-2">@passwordError</div>
                        }

                        <div class="row g-3">
                            <div class="col-12">
                                <label for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label>
                                <input type="password" id="CurrentPassword" name="CurrentPassword" class="form-control" autocomplete="current-password" />
                            </div>
                            <div class="col-md-6">
                                <label for="NewPassword" class="form-label">Mật khẩu mới</label>
                                <input type="password" id="NewPassword" name="NewPassword" class="form-control" autocomplete="new-password" />
                            </div>
                            <div class="col-md-6">
                                <label for="ConfirmPassword" class="form-label">Nhập lại mật khẩu mới</label>
                                <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            </div>
                        </div>

                        <div class="text-end mt-3">
                            <button type="submit" class="btn btn-outline-success rounded-3 px-4 fw-bold">Đổi mật khẩu</button>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
@section Scripts {
    @if (isEmployer)
    {
        <partial name="_RichEditor" />
    }
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
    <script>
        var cropper;

        function initImageCropper(inputId, previewId, placeholderId, title, fileName) {
            const fileInput = document.getElementById(inputId);
            if (!fileInput) return;

            fileInput.addEventListener('change', () => {
                const file = fileInput.files[0];
                if (!file) return;

                if (!file.type.startsWith('image/')) {
                    Swal.fire('Lỗi', 'Vui lòng chọn file ảnh.', 'error');
                    fileInput.value = '';
                    return;
                }
                if (file.size > 5 * 1024 * 1024) {
                    Swal.fire('Lỗi', 'Ảnh tối đa 5MB.', 'error');
                    fileInput.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = ev => openCropperModal(ev.target.result, fileInput, previewId, placeholderId, title, fileName);
                reader.readAsDataURL(file);
            });
        }

        function openCropperModal(src, fileInput, previewId, placeholderId, title, fileName) {
            Swal.fire({
                title: title,
                width: 600,
                html: `
                            <div style="max-height:380px;">
                                <img id="cropImage" src="${src}" style="max-width:100%; display:block;">
                            </div>
                            <div class="mt-3 d-flex justify-content-center gap-2 flex-wrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cropper.zoom(0.1)">Phóng to</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cropper.zoom(-0.1)">Thu nhỏ</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cropper.rotate(-90)">Xoay trái</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cropper.rotate(90)">Xoay phải</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cropper.reset()">Đặt lại</button>
                            </div>`,
                showCancelButton: true,
                confirmButtonText: 'Áp dụng',
                cancelButtonText: 'Hủy',
                didOpen: () => {
                    cropper = new Cropper(document.getElementById('cropImage'), {
                        aspectRatio: 1,
                        viewMode: 1,
                        dragMode: 'move',
                        autoCropArea: 1,
                        background: false
                    });
                },
                preConfirm: () => new Promise(resolve => {
                    cropper.getCroppedCanvas({
                        width: 400,
                        height: 400,
                        fillColor: '#fff',
                        imageSmoothingQuality: 'high'
                    }).toBlob(blob => resolve(blob), 'image/jpeg', 0.9);
                }),
                willClose: () => { if (cropper) cropper.destroy(); }
            }).then(result => {
                if (result.isConfirmed && result.value) {
                    applyCroppedFile(result.value, fileInput, previewId, placeholderId, fileName);
                } else {
                    fileInput.value = '';
                }
            });
        }

        function applyCroppedFile(blob, fileInput, previewId, placeholderId, fileName) {
            const file = new File([blob], fileName, { type: 'image/jpeg' });
            const transfer = new DataTransfer();
            transfer.items.add(file);
            fileInput.files = transfer.files;

            const img = document.getElementById(previewId);
            if (img) {
                img.src = URL.createObjectURL(file);
                img.style.display = '';
                img.classList.remove('d-none');
            }

            const placeholder = document.getElementById(placeholderId);
            if (placeholder) {
                placeholder.style.display = 'none';
                placeholder.classList.add('d-none');
            }
        }

        initImageCropper('AvatarFile', 'avatarPreview', 'avatarPlaceholder', 'Căn chỉnh ảnh đại diện', 'avatar.jpg');
        initImageCropper('LogoFile', 'logoPreview', 'logoPlaceholder', 'Căn chỉnh logo công ty', 'logo.jpg');
    </script>
}