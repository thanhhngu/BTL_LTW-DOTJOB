@model BTL_LTW_DOTJOB.ViewModels.Job.SearchJobViewModel
@{
    ViewData["Title"] = "Tìm kiếm việc làm";

    // Các mức lương cho ô chọn (giá trị khớp với SearchJobViewModel.SalaryRange)
    var salaryOptions = new[]
    {
        ("", "Mức lương"),
        ("lt10", "Dưới 10 triệu"),
        ("10-20", "10 - 20 triệu"),
        ("20-30", "20 - 30 triệu"),
        ("gt30", "Trên 30 triệu")
    };
}

@functions {
    // Giữ nguyên các điều kiện lọc khi chuyển trang
    object RouteFor(int page) => new
    {
        keyword = Model.Keyword,
        categoryId = Model.CategoryId,
        location = Model.Location,
        salaryRange = Model.SalaryRange,
        jobType = Model.JobType,
        page
    };
}

<div style="background-color: #f4f5f5;" class="py-4">
    <div class="container" style="max-width: 1200px;">

        <!-- 1. Form lọc -->
        <form asp-controller="Job" asp-action="Search" method="get" class="card border-0 shadow-sm rounded-4 p-3 mb-4">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-lg-3">
                    <input type="text" name="keyword" value="@Model.Keyword" class="form-control"
                           placeholder="Vị trí tuyển dụng, tên công ty">
                </div>

                <div class="col-6 col-lg-2">
                    <select name="categoryId" class="form-select" onchange="this.form.submit()">
                        <option value="">Danh mục Nghề</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">@category.Name</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-lg-2">
                    <select name="location" class="form-select" onchange="this.form.submit()">
                        <option value="">Địa điểm</option>
                        @foreach (var location in Model.Locations)
                        {
                            <option value="@location" selected="@(Model.Location == location)">@location</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-lg-2">
                    <select name="salaryRange" class="form-select" onchange="this.form.submit()">
                        @foreach (var (value, label) in salaryOptions)
                        {
                            <option value="@value" selected="@(Model.SalaryRange == value)">@label</option>
                        }
                    </select>
                </div>

                <div class="col-6 col-lg-2">
                    <select name="jobType" class="form-select" onchange="this.form.submit()">
                        <option value="">Hình thức</option>
                        @foreach (var type in Model.JobTypes)
                        {
                            <option value="@type" selected="@(Model.JobType == type)">@type</option>
                        }
                    </select>
                </div>

                <div class="col-12 col-lg-1 d-grid">
                    <button type="submit" class="btn btn-success rounded-3 fw-bold" title="Tìm kiếm">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>
                </div>
            </div>
        </form>

        <!-- 2. Tiêu đề kết quả -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h4 class="fw-bold text-dark border-start border-success border-4 ps-3 m-0">
                Tìm thấy <span class="text-success">@Model.TotalCount</span> việc làm phù hợp
            </h4>
            @if (Model.HasFilter)
            {
                <a asp-controller="Job" asp-action="Search" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="fa-solid fa-xmark me-1"></i>Xóa bộ lọc
                </a>
            }
        </div>

        <!-- 3. Danh sách việc làm -->
        @if (!Model.Items.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
                <i class="fa-regular fa-face-frown text-success fs-1 mb-3"></i>
                <p class="text-muted mb-3">Không tìm thấy việc làm phù hợp. Hãy thử đổi từ khóa hoặc bỏ bớt bộ lọc.</p>
                <div>
                    <a asp-controller="Job" asp-action="Search" class="btn btn-success rounded-3 px-4">Xem tất cả việc làm</a>
                </div>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                @foreach (var job in Model.Items)
                {
                    <partial name="_JobCard" model="job" />
                }
            </div>

            <!-- 4. Phân trang -->
            @if (Model.PageCount > 1)
            {
                <div class="d-flex justify-content-center align-items-center gap-3 mt-4 topcv-pagination">
                    @if (Model.Page > 1)
                    {
                        <a href="@Url.Action("Search", "Job", RouteFor(Model.Page - 1))"
                           class="btn btn-outline-success rounded-circle pagination-btn shadow-sm"><i class="fa-solid fa-angle-left"></i></a>
                    }
                    else
                    {
                        <button class="btn btn-light bg-white border rounded-circle pagination-btn text-muted shadow-sm" disabled>
                            <i class="fa-solid fa-angle-left"></i>
                        </button>
                    }

                    <span class="text-muted fw-medium fs-5">
                        <span style="color: #00b14f; font-weight: bold;">@Model.Page</span> / @Model.PageCount trang
                    </span>

                    @if (Model.Page < Model.PageCount)
                    {
                        <a href="@Url.Action("Search", "Job", RouteFor(Model.Page + 1))"
                           class="btn btn-outline-success rounded-circle pagination-btn shadow-sm"><i class="fa-solid fa-angle-right"></i></a>
                    }
                    else
                    {
                        <button class="btn btn-light bg-white border rounded-circle pagination-btn text-muted shadow-sm" disabled>
                            <i class="fa-solid fa-angle-right"></i>
                        </button>
                    }
                </div>
            }
        }

    </div>
</div>
