@model BTL_LTW_DOTJOB.Models.JobPosting
@using System.Security.Claims
@using BTL_LTW_DOTJOB.Services.SavedJobs
@using BTL_LTW_DOTJOB.Services.Application
@using BTL_LTW_DOTJOB.Services.Profile
@inject ISavedJobService SavedJobService
@inject IApplicationService AppService
@inject IProfileService ProfileService
@{
    ViewData["Title"] = Model?.Title ?? "Chi tiết công việc";


    var requirement = Model.Requirements ?? "";
    var match = System.Text.RegularExpressions.Regex.Match(requirement, @"\d+-\d+\s*năm");
    var experience = match.Success ? match.Value : "Không yêu cầu";

    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isCandidate = User.IsInRole("Candidate");

    if (isCandidate)
    {
        ViewData["ReportJobId"] = Model!.Id;
    }

    var hasApplied = isCandidate
        && await AppService.HasAppliedAsync(Model!.Id, User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty);

    var profile = isCandidate && !hasApplied && !Model!.IsExpired
        ? await ProfileService.GetProfileAsync(User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty)
        : null;

    var applyModel = new BTL_LTW_DOTJOB.ViewModels.Application.ApplyJobViewModel
    {
        Id = Model!.Id,
        JobTitle = Model.Title,
        FullName = profile?.FullName ?? string.Empty,
        Email = profile?.Email ?? string.Empty,
        Phone = profile?.Phone ?? string.Empty
    };

    var isSaved = (await SavedJobService.GetSavedJobIdsAsync(User.FindFirstValue(ClaimTypes.NameIdentifier))).Contains(Model!.Id);


}

<div class="container my-4">
    <div class="row g-4">
        
        <div class="col-lg-8">
            
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h1 class="fw-bold fs-3 text-dark mb-2">@Model?.Title</h1>
                
                <div class="d-flex align-items-center flex-wrap gap-3 mb-3">
                    <span class="fs-4 fw-bold text-success">
                        @(Model?.SalaryMin.HasValue == true && Model?.SalaryMax.HasValue == true 
                            ? $"{Model.SalaryMin.Value.ToString("N0")} - {Model.SalaryMax.Value.ToString("N0")} VNĐ" 
                            : "Thoả thuận")
                    </span>
                    <span class="text-muted small">| Tra cứu lương thị trường việc làm</span>
                </div>

                <div class="row g-3 mb-4 text-secondary small">
                    <div class="col-md-4 d-flex align-items-center">
                        <div class="bg-light p-2 rounded-3 me-2 text-success"><i class="fa-solid fa-location-dot"></i></div>
                        <div>
                            <span class="d-block text-muted">Địa điểm</span>
                            <span class="fw-semibold text-dark">@Model?.Location</span>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-center">
                        <div class="bg-light p-2 rounded-3 me-2 text-success"><i class="fa-solid fa-medal"></i></div>
                        <div>
                            <span class="d-block text-muted">Kinh nghiệm</span>
                            <span class="fw-semibold text-dark">
                                
                                    @experience
                                
                            </span>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-center">
                        <div class="bg-light p-2 rounded-3 me-2 text-success"><i class="fa-regular fa-clock"></i></div>
                        <div>
                            <span class="d-block text-muted">Hạn ứng tuyển</span>
                            <span class="fw-semibold @(Model!.IsExpired ? "text-danger" : "text-dark")">
                                @(Model.Deadline?.ToString("dd/MM/yyyy") ?? "Không thời hạn")
                                @if (Model.IsExpired)
                                {
                                    <span class="badge bg-danger-subtle text-danger ms-1">Đã hết hạn</span>
                                }
                            </span>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3">
                    @if (hasApplied)
                    {
                        <a asp-controller="Application" asp-action="Index"
                           class="btn btn-outline-success flex-grow-1 py-3 fw-bold rounded-3">
                            <i class="fa-solid fa-circle-check me-2"></i> Đã ứng tuyển · Xem đơn của tôi
                        </a>
                    }
                    else if (Model.IsExpired)
                    {
                        <button class="btn btn-secondary flex-grow-1 py-3 fw-bold rounded-3" disabled
                                title="Tin tuyển dụng đã hết hạn nộp hồ sơ">
                            <i class="fa-regular fa-calendar-xmark me-2"></i> Đã hết hạn ứng tuyển
                        </button>
                    }
                    else if (!isAuthenticated)
                    {
                        <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Context.Request.Path.Value"
                           class="btn btn-success flex-grow-1 py-3 fw-bold rounded-3 shadow-sm"
                           style="background-color: #00b14f;">
                            <i class="fa-solid fa-paper-plane me-2"></i> Đăng nhập để ứng tuyển
                        </a>
                    }
                    else if (isCandidate)
                    {
                        <button id="btnOpenApply" class="btn btn-success flex-grow-1 py-3 fw-bold rounded-3 shadow-sm"
                                style="background-color: #00b14f;"
                                data-bs-toggle="modal" data-bs-target="#applyModal">
                            <i class="fa-solid fa-paper-plane me-2"></i> Ứng tuyển ngay
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-secondary flex-grow-1 py-3 fw-bold rounded-3" disabled
                                title="Chỉ tài khoản Ứng viên mới có thể ứng tuyển">
                            <i class="fa-solid fa-paper-plane me-2"></i> Chỉ dành cho Ứng viên
                        </button>
                    }

                    <button type="button" class="btn btn-outline-success px-4 py-3 fw-semibold rounded-3 btn-heart" data-job-id="@Model.Id">
                        <i class="@(isSaved ? "fa-solid text-danger" : "fa-regular") fa-heart me-1"></i> <span class="heart-label">@(isSaved ? "Đã lưu" : "Lưu tin")</span>
                    </button>
                </div>
            </div>

            <div class="alert bg-white border shadow-sm rounded-4 p-3 mb-4 d-flex align-items-center">
                <div class="text-success fs-4 me-3"><i class="fa-solid fa-shield-check"></i></div>
                <div class="small text-secondary">
                    <strong class="text-dark">100% tin đăng</strong> tại trên hệ thống được cung cấp bởi các Nhà tuyển dụng đã được xác thực thông tin.
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                
                <h4 class="fw-bold text-dark border-start border-success border-4 ps-3 mb-3">Tổng quan</h4>
                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <span class="text-muted small d-block mb-1">Yêu cầu chuyên môn:</span>
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill me-1">Kinh nghiệm chuyên môn</span>
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">Đại học trở lên</span>
                    </div>
                    <div class="col-sm-6">
                        <span class="text-muted small d-block mb-1">Lĩnh vực / Ngành nghề:</span>
                        <span class="badge bg-light text-success border border-success px-3 py-2 rounded-pill">@Model?.Category?.Name</span>
                    </div>
                </div>

                <hr class="text-muted opacity-25 my-4">

                <h4 class="fw-bold text-dark border-start border-success border-4 ps-3 mb-3">Mô tả công việc</h4>
                <div class="text-secondary lh-lg mb-4">
                    @Html.SafeHtml(Model?.Description)
                    <p>Phối hợp cùng các phòng ban liên quan để triển khai công việc hiệu quả, đảm bảo đúng tiến độ và chất lượng dự án được giao.</p>
                </div>

                <h4 class="fw-bold text-dark border-start border-success border-4 ps-3 mb-3">Yêu cầu ứng viên</h4>
                <div class="text-secondary lh-lg">
                    @Html.SafeHtml(Model?.Requirements)
                </div>

            </div>
        </div>

        <div class="col-lg-4">
            
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 text-center">
                <div class="mb-3">
                    <img src="@(string.IsNullOrEmpty(Model?.Company?.Logo) ? "/images/default-logo.png" : Model.Company.Logo)" 
                         alt="Company Logo" class="rounded-3 border p-2 shadow-sm" style="width: 80px; height: 80px; object-fit: contain;">
                </div>
                <h5 class="fw-bold text-dark mb-3">@(Model?.Company?.CompanyName ?? "CÔNG TY TNHH ĐỐI TÁC TUYỂN DỤNG")</h5>
                
                <div class="text-start small text-secondary mb-4">
                    <p class="mb-2"><i class="fa-solid fa-users text-muted me-2"></i><strong>Quy mô:</strong> 100-499 nhân viên</p>
                    <p class="mb-2"><i class="fa-solid fa-location-dot text-muted me-2"></i><strong>Địa chỉ:</strong> @(Model?.Company?.CompanyAddress ?? Model?.Company?.WorkLocation ?? "Hà Nội")</p>
                    @if (!string.IsNullOrWhiteSpace(Model?.Company?.Website))
                    {
                        <p class="mb-0"><i class="fa-solid fa-globe text-muted me-2"></i><strong>Website:</strong> <a href="@Model.Company.Website" target="_blank" rel="noopener noreferrer nofollow" class="text-success text-decoration-none">Xem trang web</a></p>
                    }
                </div>

                <a asp-controller="Company" asp-action="Detail" asp-route-id="@Model?.CompanyId"
                   class="btn btn-outline-success w-100 fw-semibold rounded-3 py-2">
                    Xem trang công ty <i class="fa-solid fa-arrow-up-right-from-square ms-1 small"></i>
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold text-dark mb-3">Thông tin chung</h5>
                
                <ul class="list-unstyled small text-secondary mb-0">
                    <li class="d-flex align-items-center mb-3">
                        <div class="bg-light p-2 rounded-3 me-3 text-success"><i class="fa-solid fa-user-tie"></i></div>
                        <div>
                            <span class="d-block text-muted">Cấp bậc</span>
                            <span class="fw-semibold text-dark">Nhân viên</span>
                        </div>
                    </li>
                    <li class="d-flex align-items-center mb-3">
                        <div class="bg-light p-2 rounded-3 me-3 text-success"><i class="fa-solid fa-graduation-cap"></i></div>
                        <div>
                            <span class="d-block text-muted">Học vấn</span>
                            <span class="fw-semibold text-dark">Cao Đẳng trở lên</span>
                        </div>
                    </li>
                    <li class="d-flex align-items-center mb-3">
                        <div class="bg-light p-2 rounded-3 me-3 text-success"><i class="fa-solid fa-users-gear"></i></div>
                        <div>
                            <span class="d-block text-muted">Số lượng tuyển</span>
                            <span class="fw-semibold text-dark">1 người</span>
                        </div>
                    </li>
                    <li class="d-flex align-items-center">
                        <div class="bg-light p-2 rounded-3 me-3 text-success"><i class="fa-solid fa-briefcase"></i></div>
                        <div>
                            <span class="d-block text-muted">Hình thức làm việc</span>
                            <span class="fw-semibold text-dark">@(Model?.JobType ?? "Toàn thời gian")</span>
                        </div>
                    </li>
                </ul>
            </div>

        </div>

    </div>
</div>



@if (isCandidate)
{
<partial name="_ApplyModal" model="applyModel" />

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<partial name="_ReportModal" model="Model.Id" />
<script>
    const applyForm = document.getElementById('applyForm');
    const btnSubmit = document.getElementById('btnSubmitApply');

    document.getElementById('agreeTerms').addEventListener('change', e => {
        btnSubmit.disabled = !e.target.checked;
    });

    function markApplied() {
        const openBtn = document.getElementById('btnOpenApply');
        if (!openBtn) return;

        const link = document.createElement('a');
        link.href = '/applications';
        link.className = 'btn btn-outline-success flex-grow-1 py-3 fw-bold rounded-3';
        link.innerHTML = '<i class="fa-solid fa-circle-check me-2"></i> Đã ứng tuyển · Xem đơn của tôi';
        openBtn.replaceWith(link);
    }

    applyForm.addEventListener('submit', async e => {
        e.preventDefault();

        const cv = document.getElementById('cvFile').files[0];
        if (!cv) return Swal.fire('Thiếu CV', 'Vui lòng chọn file CV.', 'warning');
        if (cv.size > 5 * 1024 * 1024) return Swal.fire('File quá lớn', 'CV tối đa 5MB.', 'warning');

        btnSubmit.disabled = true;
        btnSubmit.textContent = 'Đang gửi...';

        try {
            const res = await fetch('/Application/Apply', {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(applyForm)
            });

            if (res.ok) {
                const data = await res.json();
                const modalEl = document.getElementById('applyModal');
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

                modalEl.addEventListener('hidden.bs.modal', () => {
                    Swal.fire('Thành công', data.message, 'success');
                    markApplied();
                }, { once: true });

                applyForm.reset();
                modal.hide();
            } else if (res.status === 401) {
                Swal.fire({
                    title: 'Cần đăng nhập',
                    text: 'Vui lòng đăng nhập để ứng tuyển.',
                    icon: 'info',
                    confirmButtonText: 'Đăng nhập'
                }).then(result => {
                    if (result.isConfirmed) {
                        window.location.href = '/Auth/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                    }
                });
            } else if (res.status === 403) {
                Swal.fire('Không có quyền', 'Chỉ tài khoản Ứng viên mới có thể ứng tuyển.', 'warning');
            } else {
                Swal.fire('Lỗi', await res.text(), 'error');
            }
        } catch {
            Swal.fire('Lỗi', 'Không kết nối được máy chủ.', 'error');
        } finally {
            btnSubmit.textContent = 'Nộp hồ sơ ứng tuyển';
            btnSubmit.disabled = !document.getElementById('agreeTerms').checked;
        }
    });
</script>
}