@model BTL_LTW_DOTJOB.ViewModels.Application.MyApplicationsViewModel
@{
    ViewData["Title"] = "Việc làm đã ứng tuyển";

    // Các tab lọc theo trạng thái đơn
    var tabs = new[]
    {
        ("", "Tất cả"),
        ("Pending", "Đã nộp"),
        ("Accepted", "Hồ sơ phù hợp"),
        ("Rejected", "Không phù hợp")
    };
}

@functions {
    static (string Label, string Css) StatusInfo(string status) => status switch
    {
        "Accepted" => ("Hồ sơ phù hợp", "bg-success-subtle text-success border border-success-subtle"),
        "Rejected" => ("Không phù hợp", "bg-danger-subtle text-danger border border-danger-subtle"),
        _ => ("Đã nộp", "bg-secondary-subtle text-secondary border border-secondary-subtle")
    };
}

<div style="background-color: #f4f5f5;" class="py-4">
    <div class="container">

        <!-- 1. Tiêu đề -->
        <h4 class="fw-bold text-dark border-start border-success border-4 ps-3 mb-3">
            Việc làm đã ứng tuyển
            <span class="text-muted fs-6 fw-normal ms-2">(@Model.TotalCount)</span>
        </h4>

        <!-- 2. Lọc theo trạng thái -->
        <div class="d-flex flex-wrap gap-2 mb-4">
            @foreach (var (value, label) in tabs)
            {
                var isActive = (Model.Status ?? "") == value;
                <a href="@Url.Action("Index", "Application", new { status = string.IsNullOrEmpty(value) ? null : value })"
                   class="btn rounded-pill px-3 @(isActive ? "btn-success" : "btn-outline-success")">
                    @label
                </a>
            }
        </div>

        <!-- 3. Danh sách đơn ứng tuyển -->
        @if (!Model.Items.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
                <i class="fa-regular fa-folder-open text-success fs-1 mb-3"></i>
                <p class="text-muted mb-3">Bạn chưa có đơn ứng tuyển nào ở mục này.</p>
                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-success rounded-3 px-4">Tìm việc ngay</a>
                </div>
            </div>
        }
        else
        {
            foreach (var item in Model.Items)
            {
                var info = StatusInfo(item.Status);

                <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                        <div>
                            <a asp-controller="Job" asp-action="Detail" asp-route-id="@item.JobId"
                               class="fw-bold fs-5 text-dark text-decoration-none">@item.JobTitle</a>
                            <div class="text-muted mt-1">
                                <i class="fa-regular fa-building me-1"></i>@item.CompanyName
                                @if (!string.IsNullOrEmpty(item.Location))
                                {
                                    <span class="ms-3"><i class="fa-solid fa-location-dot me-1"></i>@item.Location</span>
                                }
                            </div>
                            <div class="text-muted small mt-2">
                                <i class="fa-regular fa-clock me-1"></i>Ứng tuyển lúc @item.AppliedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </div>
                        </div>

                        <div class="text-end">
                            <span class="badge rounded-pill px-3 py-2 @info.Css">@info.Label</span>
                            <div class="mt-3">
                                <a asp-controller="CvFile" asp-action="Download" asp-route-applicationId="@item.ApplicationId"
                                   target="_blank" class="btn btn-outline-success btn-sm rounded-3">
                                    <i class="fa-regular fa-file-pdf me-1"></i>Xem CV đã nộp
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- 4. Phân trang -->
            if (Model.PageCount > 1)
            {
                <div class="d-flex justify-content-center align-items-center gap-3 mt-4 topcv-pagination">
                    @if (Model.Page > 1)
                    {
                        <a href="@Url.Action("Index", "Application", new { status = Model.Status, page = Model.Page - 1 })"
                           class="btn btn-outline-success rounded-circle pagination-btn"><i class="fa-solid fa-chevron-left"></i></a>
                    }
                    <span class="text-muted">@Model.Page / @Model.PageCount trang</span>
                    @if (Model.Page < Model.PageCount)
                    {
                        <a href="@Url.Action("Index", "Application", new { status = Model.Status, page = Model.Page + 1 })"
                           class="btn btn-outline-success rounded-circle pagination-btn"><i class="fa-solid fa-chevron-right"></i></a>
                    }
                </div>
            }
        }

    </div>
</div>
