@model BTL_LTW_DOTJOB.ViewModels.Job.SearchJobViewModel

<h1 class="text-white fw-bold mb-2 fs-2">Tìm việc làm nhanh, việc làm nổi bật trên toàn quốc</h1>
<p class="text-white mb-4 fs-6">Tiếp cận 60.000+ tin tuyển dụng việc làm mỗi ngày từ hàng nghìn doanh nghiệp uy tín tại Việt Nam</p>

<div class="search-wrapper bg-white p-2 mx-auto shadow" style="max-width: 1000px; border-radius: 50px;">
    <form asp-controller="Job" asp-action="Search" method="get" class="row g-0 align-items-center">
        <div class="col-md-8">
            <input type="text" name="keyword" class="form-control border-0 shadow-none px-3" placeholder="Vị trí tuyển dụng, tên công ty">
        </div>

        <div class="col-md-4 d-flex align-items-center pe-1">
            <div class="input-group border-start">
                <span class="input-group-text bg-transparent border-0"><i class="fa-solid fa-location-dot text-muted"></i></span>
                <select name="location" class="form-select border-0 shadow-none fw-medium text-muted">
                    <option value="">Địa điểm</option>
                    @foreach (var location in Model.Locations)
                    {
                        <option value="@location">@location</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-topcv-search rounded-pill px-4 fw-bold ms-2 flex-shrink-0">
                <i class="fa-solid fa-magnifying-glass me-1"></i> Tìm kiếm
            </button>
        </div>

    </form>
</div>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
