
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
@* Không nạp thêm bootstrap.bundle ở đây: _Layout đã nạp 1 bản. Nạp trùng làm dropdown bị toggle nhiều lần nên không mở được *@
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid px-4">
            <a class="navbar-brand text-success fw-bold fs-3" asp-area="" asp-controller="Home" asp-action="Index">DOTJOB<span class="text-dark fs-6 ms-1">.vn</span></a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>


            <div class="collapse navbar-collapse" id="topcvNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-medium">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-success"@*data-bs-toggle="dropdown"*@ asp-area="" asp-controller="Home" asp-action="Index">Việc làm</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle"@*data-bs-toggle="dropdown"*@ asp-area="" asp-controller="CV" asp-action="Index">Tạo CV</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle"@*data-bs-toggle="dropdown"*@>Công cụ</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle"@*data-bs-toggle="dropdown"*@>Cẩm nang nghề nghiệp</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-warning fw-bold">DOTJOB Pro</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3">
                    <a href="#" class="text-secondary fs-5"><i class="fa-regular fa-bell"></i></a>
                    <a href="#" class="text-secondary fs-5"><i class="fa-regular fa-comment-dots"></i></a>
                    <div class="vr mx-1"></div> 
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var displayName = User.Identity?.Name ?? "Tài khoản";
                        var initial = displayName.Trim().Length > 0 ? char.ToUpper(displayName.Trim()[0]).ToString() : "U";

                        <!-- Đã đăng nhập: avatar + menu tài khoản -->
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-decoration-none text-dark dropdown-toggle" id="userMenu"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center fw-bold me-2"
                                      style="width: 36px; height: 36px;">@initial</span>
                                <span class="fw-medium d-none d-md-inline">@displayName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3" aria-labelledby="userMenu">
                                @if (User.IsInRole("Candidate"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Application" asp-action="Index">
                                            <i class="fa-regular fa-file-lines text-success me-2"></i>Việc làm đã ứng tuyển
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="CV" asp-action="Index">
                                            <i class="fa-regular fa-id-card text-success me-2"></i>Tạo CV
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                <li>
                                    <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fa-solid fa-right-from-bracket me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <!-- Chưa đăng nhập -->
                        <a asp-area="" asp-controller="Auth" asp-action="Login" class="btn btn-outline-success fw-semibold rounded-3 px-3">Đăng nhập</a>
                        <a asp-area="" asp-controller="Auth" asp-action="Register" class="btn btn-success fw-semibold rounded-3 px-3">Đăng ký</a>
                    }

                    @* Chỉ hiện cho khách và Employer (Candidate/Admin không cần) *@
                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-area="" asp-controller="Auth" asp-action="Register" class="text-decoration-none text-dark ms-2 text-end lh-sm">
                            <small class="text-muted d-block" style="font-size: 0.75rem;">Bạn là nhà tuyển dụng?</small>
                            <span class="fw-bold">Đăng tuyển ngay <i class="fa-solid fa-angle-right"></i></span>
                        </a>
                    }
                    else if (User.IsInRole("Employer"))
                    {
                        @* TODO: trỏ tới trang đăng tin trong Areas/Employer khi có *@
                        <a href="#" class="text-decoration-none text-dark ms-2 text-end lh-sm">
                            <small class="text-muted d-block" style="font-size: 0.75rem;">Nhà tuyển dụng</small>
                            <span class="fw-bold">Đăng tuyển ngay <i class="fa-solid fa-angle-right"></i></span>
                        </a>
                    }
                </div>
            </div>

        </div>
    </nav>
</header>
<script>
    const navLinks = document.querySelectorAll('#topcvNav .navbar-nav .nav-link');
    const activeNavIndex = Number(sessionStorage.getItem('topcvActiveNavIndex'));

    function setActiveNavLink(link, index) {
        navLinks.forEach(navLink => navLink.classList.remove('text-success'));
        link.classList.remove('text-warning');
        link.classList.add('text-success');
        sessionStorage.setItem('topcvActiveNavIndex', index);
    }

    if (Number.isInteger(activeNavIndex) && activeNavIndex >= 0 && activeNavIndex < navLinks.length) {
        setActiveNavLink(navLinks[activeNavIndex], activeNavIndex);
    }

    navLinks.forEach((link, index) => {
        link.addEventListener('click', () => setActiveNavLink(link, index));
    });
</script>
