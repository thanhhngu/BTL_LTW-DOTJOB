@model BTL_LTW_DOTJOB.ViewModels.Profile.ProfileViewModel?
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var isEnglish = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid px-4">
            <a class="navbar-brand text-success fw-bold fs-3" asp-area="" asp-controller="Home" asp-action="Index">DOTJOB<span class="text-dark fs-6 ms-1">.vn</span></a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>


            <div class="collapse navbar-collapse" id="topcvNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-medium">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle text-success" asp-area="" asp-controller="Home" asp-action="Index">@Loc["Nav_Jobs"]</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" asp-area="" asp-controller="CV" asp-action="Index">@Loc["Nav_CreateCv"]</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3">
                    <div class="vr mx-1"></div> 
                    <div class="dropdown">
                        <a href="#" class="text-secondary text-decoration-none dropdown-toggle small" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-globe me-1"></i>@(isEnglish ? "EN" : "VI")
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                            <li><a class="dropdown-item @(isEnglish ? "" : "fw-bold")" asp-area="" asp-controller="Culture" asp-action="Set" asp-route-culture="vi-VN" asp-route-returnUrl="@returnUrl">Tiếng Việt</a></li>
                            <li><a class="dropdown-item @(isEnglish ? "fw-bold" : "")" asp-area="" asp-controller="Culture" asp-action="Set" asp-route-culture="en-US" asp-route-returnUrl="@returnUrl">English</a></li>
                        </ul>
                    </div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var displayName = User.Identity?.Name ?? Loc["Menu_Account"].Value;
                        var initial = displayName.Trim().Length > 0 ? char.ToUpper(displayName.Trim()[0]).ToString() : "U";

                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-decoration-none text-dark dropdown-toggle" id="userMenu"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                @if (!string.IsNullOrEmpty(Model?.AvatarPath))
                                {
                                    <img src="@Model.AvatarPath" alt="Avatar" class="rounded-circle object-fit-cover me-2" style="width: 36px; height: 36px;">
                                }
                                else
                                {
                                    <span class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center fw-bold me-2"
                                          style="width: 36px; height: 36px;">@initial</span>
                                }
                                <span class="fw-medium d-none d-md-inline">@displayName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3" aria-labelledby="userMenu">

                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                            <i class="fa-solid fa-gauge-high text-success me-2"></i>Trang quản trị
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                }

                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Profile" asp-action="Index">
                                        <i class="fa-regular fa-user text-success me-2"></i>@Loc["Menu_Profile"]
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>

                                @if (User.IsInRole("Candidate"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Application" asp-action="Index">
                                            <i class="fa-regular fa-file-lines text-success me-2"></i>@Loc["Menu_Applied"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="SavedJob" asp-action="Index">
                                            <i class="fa-regular fa-heart text-success me-2"></i>@Loc["Menu_Saved"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="CV" asp-action="Index">
                                            <i class="fa-regular fa-id-card text-success me-2"></i>@Loc["Nav_CreateCv"]
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                @if (User.IsInRole("Employer"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-area="Employer" asp-controller="Dashboard" asp-action="Index">
                                            <i class="fa-solid fa-chart-line text-success me-2"></i>@Loc["Menu_EmployerDashboard"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Employer" asp-controller="Jobs" asp-action="Index">
                                            <i class="fa-solid fa-briefcase text-success me-2"></i>@Loc["Menu_ManageJobs"]
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                <li>
                                    <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fa-solid fa-right-from-bracket me-2"></i>@Loc["Menu_Logout"]
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Auth" asp-action="Login" class="btn btn-outline-success fw-semibold rounded-3 px-3">@Loc["Menu_Login"]</a>
                        <a asp-area="" asp-controller="Auth" asp-action="Register" class="btn btn-success fw-semibold rounded-3 px-3">@Loc["Menu_Register"]</a>
                    }

                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-area="" asp-controller="Auth" asp-action="Register" class="text-decoration-none text-dark ms-2 text-end lh-sm">
                            <small class="text-muted d-block" style="font-size: 0.75rem;">@Loc["Menu_AreYouEmployer"]</small>
                            <span class="fw-bold">@Loc["Menu_PostJob"] <i class="fa-solid fa-angle-right"></i></span>
                        </a>
                    }
                    else if (User.IsInRole("Employer"))
                    {
                        <a asp-area="Employer" asp-controller="Jobs" asp-action="Create" class="text-decoration-none text-dark ms-2 text-end lh-sm">
                            <small class="text-muted d-block" style="font-size: 0.75rem;">@Loc["Menu_Employer"]</small>
                            <span class="fw-bold">@Loc["Menu_PostJob"] <i class="fa-solid fa-angle-right"></i></span>
                        </a>
                    }
                </div>
            </div>

        </div>
    </nav>
</header>
<script>
    const navLinks = document.querySelectorAll('#topcvNav .navbar-nav .nav-link');
    const activeNavIndex = Number(sessionStorage.getItem('topcvActiveNavIndex'));

    function setActiveNavLink(link, index) {
        navLinks.forEach(navLink => navLink.classList.remove('text-success'));
        link.classList.remove('text-warning');
        link.classList.add('text-success');
        sessionStorage.setItem('topcvActiveNavIndex', index);
    }

    if (Number.isInteger(activeNavIndex) && activeNavIndex >= 0 && activeNavIndex < navLinks.length) {
        setActiveNavLink(navLinks[activeNavIndex], activeNavIndex);
    }

    navLinks.forEach((link, index) => {
        link.addEventListener('click', () => setActiveNavLink(link, index));
    });
</script>
