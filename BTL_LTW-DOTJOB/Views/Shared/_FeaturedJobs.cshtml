@model IPagedList<BTL_LTW_DOTJOB.Models.JobPosting>
@using X.PagedList
@using X.PagedList.Mvc.Core

<div class="py-4" style="background-color: #f4f5f5;">
    <div class="container" style="max-width: 1200px;">

        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <h2 class="text-success fw-bold m-0 fs-3">Việc làm nổi bật</h2>
                <div class="bg-white rounded-pill p-1 shadow-sm border">
                    <button class="btn btn-success rounded-pill px-4 fw-medium btn-sm">Việc văn phòng</button>
                    <button class="btn btn-light rounded-pill px-4 text-muted fw-medium btn-sm border-0 bg-transparent">Việc phổ thông</button>
                </div>
            </div>
            @* <div class="d-flex align-items-center gap-2">
                <a href="#" class="text-decoration-none text-dark hover-success">Xem tất cả</a>
                <button class="btn btn-light bg-white border rounded-circle p-1 lh-1 text-muted"><i class="fa-solid fa-angle-left fa-sm"></i></button>
                <button class="btn btn-light bg-white border rounded-circle p-1 lh-1 text-muted"><i class="fa-solid fa-angle-right fa-sm"></i></button>
            </div> *@
        </div>

        <div class="bg-white p-2 rounded-3 shadow-sm mb-2 d-flex align-items-center gap-2 flex-wrap">
            <div class="border-end pe-2">
                <select class="form-select border-0 shadow-none text-muted py-1 bg-light rounded" style="width: 180px;">
                    <option>Lọc theo: Địa điểm</option>
                </select>
            </div>
            <button class="btn btn-light bg-white border rounded-circle p-1 lh-1 text-muted ms-1"><i class="fa-solid fa-angle-left fa-sm"></i></button>
            <button class="btn btn-success rounded-pill px-3 py-1 btn-sm">Ngẫu Nhiên</button>
            <button class="btn btn-light rounded-pill px-3 py-1 btn-sm text-muted bg-light border-0">Hà Nội</button>
            <button class="btn btn-light rounded-pill px-3 py-1 btn-sm text-muted bg-light border-0">Thành phố Hồ Chí Minh (cũ)</button>
            <button class="btn btn-light rounded-pill px-3 py-1 btn-sm text-muted bg-light border-0">Miền Bắc</button>
            <button class="btn btn-light rounded-pill px-3 py-1 btn-sm text-muted bg-light border-0">Miền Nam</button>
            <button class="btn btn-light bg-white border rounded-circle p-1 lh-1 text-muted ms-auto"><i class="fa-solid fa-angle-right fa-sm"></i></button>
        </div>

        <div class="alert alert-info py-2 px-3 border-0 shadow-sm d-flex justify-content-between align-items-center rounded-3 mb-3" style="background-color: #e5f2ff; color: #0056b3;">
            <div class="fs-6"><i class="fa-regular fa-lightbulb text-primary me-2"></i> <strong>Gợi ý:</strong> Di chuột vào tiêu đề việc làm để xem thêm thông tin chi tiết</div>
            <button type="button" class="btn-close" style="font-size: 0.7rem;"></button>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var job in Model)
            {
                @* <div class="col">
                    <div class="card h-100 job-card shadow-sm border-0 rounded-3">
                        <div class="card-body">
                            <h3>@job.Title</h3>
                            <p>@job.CompanyName</p>
                        </div>
                    </div>
                </div> *@
                <div class="col">
                    <a asp-controller="Job" asp-action="Detail" asp-route-id="@job.Id" target="_blank" class="text-decoration-none">
                    <div class="card h-100 job-card shadow-sm rounded-3">
                        <div class="card-body p-3 d-flex flex-column justify-content-between">
                            <div class="d-flex gap-3 mb-2">
                                <div class="job-logo border rounded border-light bg-white d-flex align-items-center justify-content-center p-1" style="width: 64px; height: 64px;">
                                    <span class="text-dark fw-bold" style="font-size: 10px;">@(job.Company?.CompanyName is { Length: > 0 } companyName ? companyName[..Math.Min(3, companyName.Length)].ToUpper() : "JOB")</span>
                                </div>
                                <div class="job-info flex-grow-1">
                                    <span class="badge bg-danger-subtle text-danger mb-1" style="font-size: 0.65rem;">NỔI BẬT</span>
                                    <h3 class="job-title text-dark fw-bold mb-1 line-clamp-2">
										@job.Title
                                    </h3>
                                    <p class="text-muted text-uppercase mb-0 line-clamp-1" style="font-size: 0.75rem;">@job.Company?.CompanyName</p>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <div class="d-flex gap-2">
                                    <span class="badge bg-light text-dark fw-normal p-2 rounded-1 text-muted">@(job.SalaryMin.HasValue && job.SalaryMax.HasValue ? $"{job.SalaryMin.Value / 1_000_000m:0.#} - {job.SalaryMax.Value / 1_000_000m:0.#} triệu" : "Thỏa thuận")</span>
                                    <span class="badge bg-light text-dark fw-normal p-2 rounded-1 text-muted">@job.Location</span>
                                </div>
                                <button class="btn btn-link text-muted p-0 btn-heart"><i class="fa-regular fa-heart fs-5"></i></button>
                            </div>
                        </div>
                    </div>
                    </a>
                </div>
            }
        </div>

        @if (Model.PageCount > 0)
        {
            <!-- PAGINATION CUSTOM THEO GIAO DIỆN TOPCV (AJAX) -->
            <div class="d-flex justify-content-center align-items-center mt-4 gap-3 topcv-pagination">

                <!-- Nút Trở lại -->
                @if (Model.HasPreviousPage)
                {
                    <button type="button" onclick="loadJobsAjax(@(Model.PageNumber - 1))" class="btn btn-outline-success rounded-circle pagination-btn shadow-sm">
                        <i class="fa-solid fa-angle-left"></i>
                    </button>
                }
                else
                {
                    <button class="btn btn-light bg-white border rounded-circle pagination-btn text-muted shadow-sm" disabled>
                        <i class="fa-solid fa-angle-left"></i>
                    </button>
                }

                <!-- Thông tin trang hiện tại -->
                <span class="text-muted fw-medium fs-5" style="letter-spacing: 0.5px;">
                    <span style="color: #00b14f; font-weight: bold;">@Model.PageNumber</span> / @Model.PageCount trang
                </span>

                <!-- Nút Tiếp theo -->
                @if (Model.HasNextPage)
                {
                    <button type="button" onclick="loadJobsAjax(@(Model.PageNumber + 1))" class="btn btn-outline-success rounded-circle pagination-btn shadow-sm">
                        <i class="fa-solid fa-angle-right"></i>
                    </button>
                }
                else
                {
                    <button class="btn btn-light bg-white border rounded-circle pagination-btn text-muted shadow-sm" disabled>
                        <i class="fa-solid fa-angle-right"></i>
                    </button>
                }

                <!-- Thẻ ẩn lưu giữ số trang tiếp theo để JS có thể đọc được cho chức năng Auto-Slide -->
                @{
                    int nextAutoPage = Model.HasNextPage ? Model.PageNumber + 1 : 1; 
                }
                <input type="hidden" id="ajax-next-page" value="@nextAutoPage" />

            </div>
        }
    </div>
</div>
