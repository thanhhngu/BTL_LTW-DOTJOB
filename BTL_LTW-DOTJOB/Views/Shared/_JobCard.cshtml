@model BTL_LTW_DOTJOB.Models.JobPosting
@using System.Security.Claims
@using BTL_LTW_DOTJOB.Services.SavedJobs
@inject ISavedJobService SavedJobService
@{
    var savedIds = await SavedJobService.GetSavedJobIdsAsync(User.FindFirstValue(ClaimTypes.NameIdentifier));
    var isSaved = savedIds.Contains(Model.Id);

    var shortName = Model.Company?.CompanyName is { Length: > 0 } companyName
        ? companyName[..Math.Min(3, companyName.Length)].ToUpper()
        : "JOB";
    var logoPath = Model.Company?.Logo;
    bool hasLogo = !string.IsNullOrEmpty(logoPath);
}

<div class="col">
    <a asp-controller="Job" asp-action="Detail" asp-route-id="@Model.Id" target="_blank" class="text-decoration-none">
        <div class="card h-100 job-card shadow-sm rounded-3">
            <div class="card-body p-3 d-flex flex-column justify-content-between">
                <div class="d-flex gap-3 mb-2">
                    <div class="job-logo border rounded border-light bg-white p-1 flex-shrink-0"
                         style="width: 64px; height: 64px; display: grid; place-items: center; overflow: hidden;">
                        @if (hasLogo)
                        {
                            <img src="@logoPath"
                                 alt="@(Model.Company?.CompanyName ?? "Logo")"
                                 style="width: 100%; height: 100%; object-fit: contain;"
                                 onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />
                            <span class="text-dark fw-bold d-none" style="font-size: 12px; line-height: 1;">@shortName</span>
                        }
                        else
                        {
                            <span class="text-dark fw-bold" style="font-size: 12px; line-height: 1;">@shortName</span>
                        }
                    </div>
                    <div class="job-info flex-grow-1">
                        @if (Model.IsExpired)
                        {
                            <span class="badge bg-secondary mb-1" style="font-size: 0.65rem;">ĐÃ HẾT HẠN</span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger mb-1" style="font-size: 0.65rem;">NỔI BẬT</span>
                        }
                        <h3 class="job-title text-dark fw-bold mb-1 line-clamp-2">
                            @Model.Title
                        </h3>
                        <p class="text-muted text-uppercase mb-0 line-clamp-1" style="font-size: 0.75rem;">@Model.Company?.CompanyName</p>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="badge bg-light text-dark fw-normal p-2 rounded-1 text-muted">@(Model.SalaryMin.HasValue && Model.SalaryMax.HasValue ? $"{Model.SalaryMin.Value / 1_000_000m:0.#} - {Model.SalaryMax.Value / 1_000_000m:0.#} triệu" : "Thỏa thuận")</span>
                        <span class="badge bg-light text-dark fw-normal p-2 rounded-1 text-muted">@Model.Location</span>
                    </div>
                    <button type="button" class="btn btn-link p-0 btn-heart @(isSaved ? "" : "text-muted")" data-job-id="@Model.Id"><i class="@(isSaved ? "fa-solid text-danger" : "fa-regular") fa-heart fs-5"></i></button>
                </div>
            </div>
        </div>
    </a>
</div>
