
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<section class="topcv-banner-section py-5">
    <div class="container text-center pt-3 pb-4">
        <partial name="_SearchBox" />
    </div>
    @if (ViewData["ShowHeroBanner"] as bool? == true)
    {
        <div class="topcv-banner-content card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-body p-2">
                <div class="row g-2 align-items-stretch">
                    @await Component.InvokeAsync("CategoryMenu")
                    <partial name="_BannerCarousel" />
                </div>
            </div>
        </div>
    }
    
</section>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>