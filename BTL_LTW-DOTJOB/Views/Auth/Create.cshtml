@model BTL_LTW_DOTJOB.ViewModels.Auth.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/StyleAuth.css">
    <title>Create</title>
    <style>
            /* css loi do lib validation*/
            .field-validation-error {
                color: var(--danger, #ef4444);
                font-size: 1.2rem;
                display: block;
                margin-top: 4px;
            }

            .input-validation-error {
                border-color: var(--danger, #ef4444) !important;
                box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15) !important;
            }
    </style>
</head>
<body>
    <div class="main">
        <form asp-controller="Auth" asp-action="Register" method="POST" class="form" id="form-1">
            <h3 class="heading">Form đăng ký</h3>
            <p class="desc">...</p>

            <div class="form-group">
                <label asp-for="Role" class="form-label">Bạn đăng ký với vai trò:</label>
                <select id="RoleSelect" asp-for="Role" class="form-control">
                    <option value="Candidate">Ứng viên</option>
                    <option value="Employer">Nhà tuyển dụng</option>
                </select>
                <span asp-validation-for="Role" class="form-message"></span>
            </div>

            <div class="spacer"></div>

            <div class="form-group">
                <label asp-for="FullName" class="form-label">Tên đầy đủ</label>
                <input asp-for="FullName" type="text" placeholder="VD: Nguyen Van A" class="form-control">
                <span asp-validation-for="FullName" class="form-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" placeholder="VD: email@domain.com" class="form-control">
                <span asp-validation-for="Email" class="form-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Phone" class="form-label">Số điện thoại</label>
                <input asp-for="Phone" type="text" placeholder="VD: 0123456789" class="form-control">
                <span asp-validation-for="Phone" class="form-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">Mật khẩu</label>
                <input asp-for="Password" type="password" placeholder="Nhập mật khẩu" class="form-control">
                <span asp-validation-for="Password" class="form-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="PasswordConfirmation" class="form-label">Nhập lại mật khẩu</label>
                <input asp-for="PasswordConfirmation" placeholder="Nhập lại mật khẩu" type="password" class="form-control">
                <span asp-validation-for="PasswordConfirmation" class="form-message"></span>
            </div>

            <div id="group-employer" style="display: none;">
                <div class="form-group">
                    <label asp-for="CompanyName" class="form-label">Tên công ty</label>
                    <input asp-for="CompanyName" type="text" class="form-control" placeholder="VD: Công ty TNHH ABC">
                    <span asp-validation-for="CompanyName" class="form-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="WorkLocation" class="form-label">Khu vực làm việc</label>
                    <select id="WorkLocation" asp-for="WorkLocation" class="form-control">
                        <option value="">-- Chọn Tỉnh/Thành phố --</option>
                    </select>
                    <span asp-validation-for="WorkLocation" class="form-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CompanyAddress" class="form-label">Địa chỉ công ty cụ thể</label>
                    <input asp-for="CompanyAddress" type="text" class="form-control" placeholder="VD: Tòa nhà Keangnam, Phạm Hùng, Nam Từ Liêm">
                    <span asp-validation-for="CompanyAddress" class="form-message"></span>
                </div>
            </div>

            <button type="submit" class="form-submit">Đăng ký</button>
            <a id="link-tab" href="@Url.Action("Login", "Auth")">Login!!</a>
        </form>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function() {
                const roleSelect = document.getElementById('RoleSelect');
                const groupEmployer = document.getElementById('group-employer');

                function toggleEmployerGroup() {
                    if (roleSelect.value === 'Employer') {
                        groupEmployer.style.display = 'block';
                    } else {
                        groupEmployer.style.display = 'none';
                    }
                }

                toggleEmployerGroup();
                roleSelect.addEventListener('change', toggleEmployerGroup);

                const provinces = [
                    "Hà Nội", "TP Hồ Chí Minh", "Đà Nẵng", "Cần Thơ", "Hải Phòng",
                    "An Giang", "Bà Rịa - Vũng Tàu", "Bắc Giang", "Bắc Kạn", "Bạc Liêu", "Bắc Ninh",
                    "Bến Tre", "Bình Định", "Bình Dương", "Bình Phước", "Bình Thuận", "Cà Mau",
                    "Cao Bằng", "Đắk Lắk", "Đắk Nông", "Điện Biên", "Đồng Nai", "Đồng Tháp",
                    "Gia Lai", "Hà Giang", "Hà Nam", "Hà Tĩnh", "Hải Dương", "Hậu Giang",
                    "Hòa Bình", "Hưng Yên", "Khánh Hòa", "Kiên Giang", "Kon Tum", "Lai Châu",
                    "Lâm Đồng", "Lạng Sơn", "Lào Cai", "Long An", "Nam Định", "Nghệ An",
                    "Ninh Bình", "Ninh Thuận", "Phú Thọ", "Phú Yên", "Quảng Bình", "Quảng Nam",
                    "Quảng Ngãi", "Quảng Ninh", "Quảng Trị", "Sóc Trăng", "Sơn La", "Tây Ninh",
                    "Thái Bình", "Thái Nguyên", "Thanh Hóa", "Thừa Thiên Huế", "Tiền Giang",
                    "Trà Vinh", "Tuyên Quang", "Vĩnh Long", "Vĩnh Phúc", "Yên Bái"
                ];

                const workLocationSelect = document.getElementById('WorkLocation');

                // Lưu lại tỉnh thành cũ nếu form bị lỗi
                const selectedLocation = "@(Model?.WorkLocation ?? "")";

                if (workLocationSelect) {
                    provinces.forEach(function(province) {
                        if (province === "An Giang") {
                            const separator = document.createElement('option');
                            separator.disabled = true;
                            separator.text = "-------------------";
                            workLocationSelect.appendChild(separator);
                        }

                        const option = document.createElement('option');
                        option.value = province;
                        option.text = province;

                        if (province === selectedLocation) {
                            option.selected = true;
                        }

                        workLocationSelect.appendChild(option);
                    });
                }
            });
    </script>
</body>
</html>