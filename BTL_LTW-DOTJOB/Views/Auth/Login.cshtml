@{
Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/StyleAuth.css">
    <title>Login</title>
</head>
<body>
    <div class="main">
        <form action="" method="POST" class="form" id="form-2">
            <h3 class="heading">LOGIN</h3>
            <p class="desc">...</p>

            <div class="spacer"></div>

            <div class="form-group">
                <label for="email" class="form-label">Email</label>
                <input id="email" name="email" type="text" placeholder="VD: email@domain.com" class="form-control">
                <span class="form-message"></span>
            </div>

            <div class="form-group">
                <!-- Chú ý: Ở file gốc id là password_hash nhưng trong logic validator kiểm tra #password. Nên đổi id thành password để JS hoạt động chính xác -->
                <label for="password" class="form-label">Mật khẩu</label>
                <input id="password" name="password_hash" type="password" placeholder="Nhập mật khẩu" class="form-control">
                <span class="form-message"></span>
            </div>
            <div class="form-group">
                <label for="key_esp" class="form-label">Key ESP</label>
                <input id="key_esp" name="key_esp" type="password" placeholder="Nhập key ESP" class="form-control">
                <span class="form-message"></span>
            </div>

            <button class="form-submit">Login</button>
            <a id="link-tab" href="@Url.Action("Create", "Account")">Create Now!!</a>
        </form>
    </div>
</body>
</html>