@using BTL_LTW_DOTJOB.Models
@model IEnumerable<BTL_LTW_DOTJOB.Models.JobPosting>

@{
    ViewData["Title"] = "Trang chủ - Tìm việc làm";
	ViewData["ShowHeroBanner"] = true;
}

<partial name="_HeroBanner"  />

<div id="featured-jobs-container">
    <partial name="_FeaturedJobs" model="Model" />
</div>
@section Scripts {
    <script>
        let autoSlideTimer;
        let isHovering = false;

        const jobsContainer = document.getElementById('featured-jobs-container');

        function loadJobsAjax(page) {
            jobsContainer.style.opacity = '0.5';

            fetch(`/Home/LoadFeaturedJobs?page=${page}`)
                .then(response => response.text())
                .then(html => {
                    jobsContainer.innerHTML = html;
                    jobsContainer.style.opacity = '1';

                    isHovering = false;

                    startAutoSlide();
                })
                .catch(err => console.error('Lỗi khi tải việc làm:', err));
        }

        function startAutoSlide() {
            clearInterval(autoSlideTimer);
            if (isHovering) return;

            autoSlideTimer = setInterval(() => {
                const next = document.getElementById('ajax-next-page');
                if (next) loadJobsAjax(next.value);
            }, 3000);
        }

        jobsContainer.addEventListener('mouseover', e => {
            if (!e.target.closest('.job-card') || isHovering) return;

            isHovering = true;
            clearInterval(autoSlideTimer);
        });

        jobsContainer.addEventListener('mouseout', e => {
            const leftCard = e.target.closest('.job-card');
            if (!leftCard) return;

            if (e.relatedTarget && leftCard.contains(e.relatedTarget)) return;

            isHovering = false;
            startAutoSlide();
        });

        startAutoSlide();
    </script>
}