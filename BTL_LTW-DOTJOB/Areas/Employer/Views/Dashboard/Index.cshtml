@model BTL_LTW_DOTJOB.Areas.Employer.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = Loc["Emp_Dashboard"].Value;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1 fs-4">@(Loc["Dash_Hello", User.Identity?.Name ?? ""])</h3>
        <p class="text-muted mb-0">@(Loc["Dash_Subtitle", Model.CompanyName])</p>
    </div>
    <a asp-area="Employer" asp-controller="Jobs" asp-action="Create" class="btn btn-success">@Loc["Dash_NewJob"]</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <a asp-area="Employer" asp-controller="Jobs" asp-action="Index" asp-route-status="open"
           class="card shadow-sm emp-stat text-decoration-none text-body h-100">
            <span class="emp-stat-icon green"><i class="fa-solid fa-briefcase"></i></span>
            <div>
                <div class="emp-stat-label">@Loc["Dash_OpenJobs"]</div>
                <div class="emp-stat-value">@Model.OpenJobs</div>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-area="Employer" asp-controller="Applications" asp-action="Index"
           class="card shadow-sm emp-stat text-decoration-none text-body h-100">
            <span class="emp-stat-icon blue"><i class="fa-solid fa-file-lines"></i></span>
            <div>
                <div class="emp-stat-label">@Loc["Dash_TotalCv"]</div>
                <div class="emp-stat-value">@Model.TotalApplications</div>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-area="Employer" asp-controller="Applications" asp-action="Index"
           asp-route-status="@ApplicationStatus.Pending"
           class="card shadow-sm emp-stat text-decoration-none text-body h-100">
            <span class="emp-stat-icon amber"><i class="fa-solid fa-hourglass-half"></i></span>
            <div>
                <div class="emp-stat-label">@Loc["Dash_PendingCv"]</div>
                <div class="emp-stat-value">@Model.PendingApplications</div>
            </div>
        </a>
    </div>
</div>

<div class="card shadow-sm emp-panel">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <span class="fw-semibold">@Loc["Dash_Recent"]</span>
        <a asp-area="Employer" asp-controller="Applications" asp-action="Index" class="small">@Loc["Dash_ViewAll"]</a>
    </div>
    @if (Model.RecentApplications.Count == 0)
    {
        <div class="text-center text-muted py-4">@Loc["Dash_Empty"]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Loc["Dash_Candidate"]</th>
                        <th>@Loc["Dash_Position"]</th>
                        <th>@Loc["Dash_AppliedDate"]</th>
                        <th>@Loc["Dash_Status"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RecentApplications)
                    {
                        <tr>
                            <td class="fw-semibold">@item.CandidateName</td>
                            <td>@item.JobTitle</td>
                            <td>@item.AppliedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge @ApplicationStatus.BadgeClass(item.Status)">@ApplicationStatus.Label(item.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
