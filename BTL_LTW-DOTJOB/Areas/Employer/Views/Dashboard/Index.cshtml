@model BTL_LTW_DOTJOB.Areas.Employer.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <div>
        <h3 class="fw-bold mb-1">Xin chào, @User.Identity?.Name</h3>
        <p class="text-muted mb-0">Quản lý tin tuyển dụng và hồ sơ ứng viên của @Model.CompanyName tại đây.</p>
    </div>
    <a asp-area="Employer" asp-controller="Jobs" asp-action="Create" class="btn btn-success">Đăng tin mới</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <a asp-area="Employer" asp-controller="Jobs" asp-action="Index" asp-route-status="open"
           class="card shadow-sm text-decoration-none text-body h-100">
            <div class="card-body">
                <div class="text-muted">Tin đang mở</div>
                <div class="fs-3 fw-bold">@Model.OpenJobs</div>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-area="Employer" asp-controller="Applications" asp-action="Index"
           class="card shadow-sm text-decoration-none text-body h-100">
            <div class="card-body">
                <div class="text-muted">Tổng số CV</div>
                <div class="fs-3 fw-bold">@Model.TotalApplications</div>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-4">
        <a asp-area="Employer" asp-controller="Applications" asp-action="Index"
           asp-route-status="@ApplicationStatus.Pending"
           class="card shadow-sm text-decoration-none text-body h-100">
            <div class="card-body">
                <div class="text-muted">CV chờ duyệt</div>
                <div class="fs-3 fw-bold">@Model.PendingApplications</div>
            </div>
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Đơn ứng tuyển mới nhất</span>
        <a asp-area="Employer" asp-controller="Applications" asp-action="Index" class="small">Xem tất cả</a>
    </div>
    @if (Model.RecentApplications.Count == 0)
    {
        <div class="text-center text-muted py-4">Chưa có ứng viên nào nộp hồ sơ.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ứng viên</th>
                        <th>Vị trí</th>
                        <th>Ngày nộp</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.RecentApplications)
                    {
                        <tr>
                            <td class="fw-semibold">@item.CandidateName</td>
                            <td>@item.JobTitle</td>
                            <td>@item.AppliedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td><span class="badge @ApplicationStatus.BadgeClass(item.Status)">@ApplicationStatus.Label(item.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
