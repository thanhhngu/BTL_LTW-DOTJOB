@using X.PagedList
@model IPagedList<BTL_LTW_DOTJOB.Models.Application>
@{
    ViewData["Title"] = "Ứng viên";
}

<h3 class="fw-bold mb-3">Ứng viên</h3>

@* Chứa anti-forgery token để JS gửi kèm khi gọi API đổi trạng thái *@
<div id="antiforgery">@Html.AntiForgeryToken()</div>
<div id="api-alert"></div>

<div class="card shadow-sm mb-3">
    <div class="card-body row g-2">
        <div class="col-12 col-md-6">
            <select id="jobId" class="form-select" asp-items="ViewBag.Jobs" onchange="loadApplications(1)">
                <option value="">Tất cả tin tuyển dụng</option>
            </select>
        </div>
        <div class="col-12 col-md-4">
            <select id="status" class="form-select" asp-items="ViewBag.StatusOptions" onchange="loadApplications(1)"></select>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div id="application-list">
        <partial name="_ApplicationTable" model="Model" />
    </div>
</div>

@* Hộp hiển thị thư giới thiệu, nội dung được gán bằng textContent nên không chạy được HTML/script *@
<div class="modal fade" id="coverLetterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="coverLetterTitle">Thư giới thiệu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="coverLetterBody" style="white-space: pre-wrap;"></div>
        </div>
    </div>
</div>

@* Hộp báo cáo ứng viên (nộp CV linh tinh, spam...). Admin sẽ xem xét và có thể khóa tài khoản *@
<div class="modal fade" id="reportCandidateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="reportCandidateForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="reportCandidateTitle">Báo cáo ứng viên</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-2">Mô tả lý do (nộp CV không liên quan, spam, thông tin giả mạo...). Quản trị viên sẽ xem xét và quyết định có khóa tài khoản hay không.</p>
                    <textarea id="reportCandidateContent" class="form-control" rows="5" maxlength="1000"
                              placeholder="Tối thiểu 10 ký tự"></textarea>
                    <div class="d-flex justify-content-between mt-1">
                        <span id="reportCandidateError" class="text-danger small"></span>
                        <span class="text-muted small"><span id="reportCandidateCount">0</span>/1000</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" id="btnSubmitReportCandidate" class="btn btn-danger">Gửi báo cáo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const listEl = document.getElementById('application-list');
        let latestRequest = 0; // bỏ qua kết quả của request cũ khi người dùng đổi bộ lọc liên tục

        // Ghép bộ lọc hiện tại thành chuỗi query, bỏ qua giá trị rỗng cho URL gọn
        function buildQuery(page) {
            const params = new URLSearchParams();
            const jobId = document.getElementById('jobId').value;
            const status = document.getElementById('status').value;
            if (jobId) params.set('jobId', jobId);
            if (status) params.set('status', status);
            if (page > 1) params.set('page', page);
            const query = params.toString();
            return query ? '?' + query : '';
        }

        async function loadApplications(page) {
            const requestId = ++latestRequest;
            listEl.classList.add('opacity-50'); // báo đang tải

            try {
                // Header X-Requested-With: server trả partial, và trả 401/403 thay vì chuyển hướng khi hết phiên
                const response = await fetch('/Employer/Applications' + buildQuery(page), { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (requestId !== latestRequest) return;

                if (response.status === 401 || response.status === 403) {
                    location.reload(); // hết phiên đăng nhập
                    return;
                }
                if (!response.ok) throw new Error('HTTP ' + response.status);

                listEl.innerHTML = await response.text();

                // Server có thể đã đổi số trang (vd: ?page=999 thì về trang cuối)
                const pager = listEl.querySelector('[data-page-number]');
                const currentPage = pager ? Number(pager.dataset.pageNumber) : 1;

                // Cập nhật URL để F5 / nút Quay lại / chia sẻ link vẫn giữ bộ lọc và trang
                history.replaceState(null, '', '/Employer/Applications' + buildQuery(currentPage));
            } catch (error) {
                if (requestId === latestRequest) {
                    showError('Không tải được danh sách ứng viên. Vui lòng thử lại.');
                }
            } finally {
                if (requestId === latestRequest) listEl.classList.remove('opacity-50');
            }
        }

        // Hiện/xoá thông báo của API ở đầu trang (type: danger | success)
        function showError(message) { showAlert(message, 'danger'); }
        function showSuccess(message) { showAlert(message, 'success'); }

        function showAlert(message, type) {
            const box = document.getElementById('api-alert');
            box.innerHTML = '';
            const alert = document.createElement('div');
            alert.className = 'alert alert-' + type + ' alert-dismissible fade show';
            alert.textContent = message;
            const close = document.createElement('button');
            close.type = 'button';
            close.className = 'btn-close';
            close.setAttribute('data-bs-dismiss', 'alert');
            alert.appendChild(close);
            box.appendChild(alert);
        }

        // Gọi PUT /api/applications/{id}/status rồi cập nhật badge và nút ngay trên trang (không reload)
        async function updateStatus(id, status) {
            const token = document.querySelector('#antiforgery input[name="__RequestVerificationToken"]').value;

            // Khoá các nút của dòng này trong lúc chờ (chống bấm liên tục), lỗi thì trả về như cũ
            const buttons = [...document.querySelectorAll('#actions-' + id + ' button')];
            const previous = buttons.map(button => button.disabled);
            buttons.forEach(button => button.disabled = true);
            const restore = () => buttons.forEach((button, i) => button.disabled = previous[i]);

            let response;
            try {
                response = await fetch(`/api/applications/${id}/status`, {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ status })
                });
            } catch (error) {
                // Mất mạng hoặc server không phản hồi
                restore();
                showError('Không kết nối được máy chủ. Vui lòng thử lại.');
                return;
            }

            if (response.status === 401) {
                location.reload(); // hết phiên đăng nhập
                return;
            }

            if (!response.ok) {
                restore();
                let message = 'Không thể cập nhật trạng thái. Vui lòng thử lại.';
                try {
                    const error = await response.json();
                    if (error.message) message = error.message;
                } catch { }
                showError(message);
                return;
            }

            const data = await response.json();

            // Đổi màu và chữ của badge
            const badgeClass = { Pending: 'text-bg-secondary', Accepted: 'text-bg-success', Rejected: 'text-bg-danger' };
            const badge = document.getElementById('badge-' + id);
            badge.className = 'badge ' + badgeClass[data.status];
            badge.textContent = data.label;

            // Khoá nút trùng trạng thái hiện tại, ẩn "Đặt lại" khi đang chờ duyệt
            document.querySelectorAll('#actions-' + id + ' button').forEach(button => {
                button.disabled = button.dataset.status === data.status;
                if (button.dataset.status === 'Pending') {
                    button.classList.toggle('d-none', data.status === 'Pending');
                }
            });
        }

        // ===== Báo cáo ứng viên =====
        const reportForm = document.getElementById('reportCandidateForm');
        const reportContent = document.getElementById('reportCandidateContent');
        const reportCount = document.getElementById('reportCandidateCount');
        const reportError = document.getElementById('reportCandidateError');
        const reportButton = document.getElementById('btnSubmitReportCandidate');
        const reportModalEl = document.getElementById('reportCandidateModal');
        let reportApplicationId = null; // đơn ứng tuyển đang được báo cáo

        reportContent.addEventListener('input', () => { reportCount.textContent = reportContent.value.length; });

        reportForm.addEventListener('submit', async e => {
            e.preventDefault();
            reportError.textContent = '';

            const text = reportContent.value.trim();
            if (text.length < 10) {
                reportError.textContent = 'Nội dung báo cáo tối thiểu 10 ký tự.';
                return;
            }

            const token = document.querySelector('#antiforgery input[name="__RequestVerificationToken"]').value;
            reportButton.disabled = true;
            try {
                const response = await fetch('/Employer/Applications/ReportCandidate/' + encodeURIComponent(reportApplicationId), {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token },
                    body: new URLSearchParams({ content: text })
                });

                if (response.ok) {
                    const data = await response.json();
                    bootstrap.Modal.getOrCreateInstance(reportModalEl).hide();
                    showSuccess(data.message);
                } else if (response.status === 401 || response.status === 403) {
                    location.reload(); // hết phiên đăng nhập
                } else {
                    reportError.textContent = await response.text();
                }
            } catch {
                reportError.textContent = 'Không kết nối được máy chủ.';
            } finally {
                reportButton.disabled = false;
            }
        });

        // Bảng được nạp lại bằng AJAX nên gắn sự kiện ở document thay vì từng nút
        document.addEventListener('click', function (e) {
            const reportBtn = e.target.closest('.btn-report-candidate');
            if (!reportBtn) return;

            reportApplicationId = reportBtn.dataset.applicationId;
            document.getElementById('reportCandidateTitle').textContent = 'Báo cáo ứng viên - ' + reportBtn.dataset.name;
            reportContent.value = '';
            reportCount.textContent = '0';
            reportError.textContent = '';
            bootstrap.Modal.getOrCreateInstance(reportModalEl).show();
        });

        // Bảng được nạp lại bằng AJAX nên gắn sự kiện ở document thay vì từng nút
        document.addEventListener('click', function (e) {
            const button = e.target.closest('.btn-cover-letter');
            if (!button) return;

            document.getElementById('coverLetterTitle').textContent = 'Thư giới thiệu - ' + button.dataset.name;
            document.getElementById('coverLetterBody').textContent = button.dataset.cover;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('coverLetterModal')).show();
        });
    </script>
}
