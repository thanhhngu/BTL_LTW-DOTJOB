@using X.PagedList
@model IPagedList<BTL_LTW_DOTJOB.Models.Application>

@if (Model.Count == 0)
{
    <div class="text-center text-muted py-5">Chưa có đơn ứng tuyển nào phù hợp.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ứng viên</th>
                    <th>Vị trí ứng tuyển</th>
                    <th>Ngày nộp</th>
                    <th>Trạng thái</th>
                    <th>CV</th>
                    <th>Thư giới thiệu</th>
                    <th>Duyệt CV</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var application in Model)
                {
                    // Hệ thống lưu "..." khi ứng viên không viết thư giới thiệu
                    var coThuGioiThieu = !string.IsNullOrWhiteSpace(application.CoverLetter) && application.CoverLetter.Trim() != "...";
                    <tr>
                        <td>
                            <div class="fw-semibold">@application.User?.FullName</div>
                            <small class="text-muted d-block">@application.User?.Email</small>
                            <small class="text-muted d-block">@application.User?.Phone</small>
                        </td>
                        <td>@application.JobPosting?.Title</td>
                        <td>@application.AppliedDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <span id="badge-@application.Id" class="badge @ApplicationStatus.BadgeClass(application.Status)">
                                @ApplicationStatus.Label(application.Status)
                            </span>
                        </td>
                        <td>
                            @* CV nằm ngoài wwwroot, chỉ tải được qua CvFileController (có kiểm tra quyền) *@
                            <a asp-area="" asp-controller="CvFile" asp-action="Download"
                               asp-route-applicationId="@application.Id" target="_blank"
                               class="btn btn-sm btn-outline-primary">Xem / tải CV</a>
                        </td>
                        <td>
                            @if (coThuGioiThieu)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary btn-cover-letter"
                                        data-name="@application.User?.FullName"
                                        data-cover="@application.CoverLetter">Xem thư</button>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @* Nút đang trùng trạng thái hiện tại thì bị khoá; "Đặt lại" chỉ hiện khi đã Pass/Fail *@
                            <div id="actions-@application.Id" class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-success" data-status="@ApplicationStatus.Accepted"
                                        disabled="@(application.Status == ApplicationStatus.Accepted)"
                                        onclick="updateStatus('@application.Id', '@ApplicationStatus.Accepted')">Pass</button>
                                <button type="button" class="btn btn-sm btn-danger" data-status="@ApplicationStatus.Rejected"
                                        disabled="@(application.Status == ApplicationStatus.Rejected)"
                                        onclick="updateStatus('@application.Id', '@ApplicationStatus.Rejected')">Fail</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary @(application.Status == ApplicationStatus.Pending ? "d-none" : "")"
                                        data-status="@ApplicationStatus.Pending"
                                        onclick="updateStatus('@application.Id', '@ApplicationStatus.Pending')">Đặt lại</button>
                                @* Báo cáo ứng viên nộp CV linh tinh / spam để Admin xem xét (có thể khóa tài khoản) *@
                                <button type="button" class="btn btn-sm btn-outline-danger btn-report-candidate"
                                        title="Báo cáo ứng viên này"
                                        data-application-id="@application.Id"
                                        data-name="@application.User?.FullName">
                                    <i class="fa-regular fa-flag"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center p-3 border-top" data-page-number="@Model.PageNumber">
        <small class="text-muted">Tổng @Model.TotalItemCount đơn</small>
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn btn-outline-success btn-sm"
                    onclick="loadApplications(@(Model.PageNumber - 1))" disabled="@(!Model.HasPreviousPage)">Trước</button>
            <span class="text-muted">@Model.PageNumber / @Model.PageCount</span>
            <button type="button" class="btn btn-outline-success btn-sm"
                    onclick="loadApplications(@(Model.PageNumber + 1))" disabled="@(!Model.HasNextPage)">Sau</button>
        </div>
    </div>
}
