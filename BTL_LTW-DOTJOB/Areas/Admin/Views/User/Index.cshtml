@model BTL_LTW_DOTJOB.ViewModels.Admin.UserListViewModel
@{
    ViewData["Title"] = "Quản lý người dùng";
}

@* Thông báo sau khi khóa / mở khóa *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@* Bộ lọc: gửi bằng GET để link có thể sao chép và phân trang giữ được bộ lọc *@
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="Tìm theo họ tên hoặc email..." />
    </div>
    <div class="col-md-3">
        <select name="role" class="form-select">
            <option value="" selected="@(string.IsNullOrEmpty(Model.Role))">Tất cả vai trò</option>
            <option value="Candidate" selected="@(Model.Role == "Candidate")">Ứng viên</option>
            <option value="Employer" selected="@(Model.Role == "Employer")">Nhà tuyển dụng</option>
            <option value="Admin" selected="@(Model.Role == "Admin")">Admin</option>
        </select>
    </div>
    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">Tất cả trạng thái</option>
            <option value="active" selected="@(Model.Status == "active")">Đang hoạt động</option>
            <option value="locked" selected="@(Model.Status == "locked")">Đã khóa</option>
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-outline-secondary">Lọc</button>
    </div>
</form>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Điện thoại</th>
                    <th>Vai trò</th>
                    <th>Ngày tạo</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Không tìm thấy người dùng nào.</td></tr>
                }
                @foreach (var u in Model.Users)
                {
                    <tr>
                        <td class="fw-semibold">@u.FullName</td>
                        <td>@u.Email</td>
                        <td>@u.Phone</td>
                        <td>
                            @if (u.RoleName == "Admin")
                            {
                                <span class="badge bg-dark">Admin</span>
                            }
                            else if (u.RoleName == "Employer")
                            {

                                <span class="badge bg-info text-dark">Nhà tuyển dụng</span>
                            }
                            else
                            {

                                <span class="badge bg-secondary">Ứng viên</span>
                            }
                        </td>
                        <td>@u.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            else
                            {

                                <span class="badge bg-danger">Đã khóa</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (u.RoleName == "Admin")
                            {
                                <span class="text-muted small">—</span>
                            }
                            else
                            {
                                <form asp-action="ToggleLock" method="post" class="d-inline"
                                      onsubmit="return confirm('@(u.IsActive ? "Khóa" : "Mở khóa") tài khoản @u.Email?');">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    @* Gửi kèm bộ lọc để sau khi khóa vẫn ở đúng trang đang xem *@
                                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                                    <input type="hidden" name="role" value="@Model.Role" />
                                    <input type="hidden" name="status" value="@Model.Status" />
                                    <input type="hidden" name="page" value="@Model.Page" />
                                    @if (u.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Khóa</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success">Mở khóa</button>
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Phân trang: giữ nguyên bộ lọc khi chuyển trang *@
@if (Model.TotalPages > 1)
{
    <nav class="mt-3 d-flex justify-content-between align-items-center">
        <div class="text-muted small">Tổng @Model.TotalItems người dùng, trang @Model.Page / @Model.TotalPages</div>
        <ul class="pagination mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                   asp-route-keyword="@Model.Keyword" asp-route-role="@Model.Role" asp-route-status="@Model.Status">«</a>
            </li>
            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@p"
                       asp-route-keyword="@Model.Keyword" asp-route-role="@Model.Role" asp-route-status="@Model.Status">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                   asp-route-keyword="@Model.Keyword" asp-route-role="@Model.Role" asp-route-status="@Model.Status">»</a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
}