@model BTL_LTW_DOTJOB.ViewModels.Admin.CategoryFormViewModel
@{
    ViewData["Title"] = "Sửa danh mục";
}

<div class="card shadow-sm border-0" style="max-width: 640px;">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" /> @* Giữ Id để biết đang sửa danh mục nào *@
            <partial name="_CategoryForm" model="Model" />
            <button type="submit" class="btn btn-success">Cập nhật</button>
            <a asp-action="Index" class="btn btn-light">Hủy</a>
        </form>
    </div>
</div>