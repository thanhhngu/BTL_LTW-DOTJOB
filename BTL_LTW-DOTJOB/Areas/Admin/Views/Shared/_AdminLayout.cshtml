@using BTL_LTW_DOTJOB.Services.Auth
@{
    // var me = Context.Session.GetUser();
    // var email = me?.Email ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "admin";
    var email = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "admin";
    var initial = email.Substring(0, 1).ToUpper();

    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - DOTJOB Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
        :root {
            --brand: #188a5a;
            --brand-soft: #e8f4ee;
            --topbar-h: 64px;
        }

        body {
            background: #f4f6f9;
        }

        .topbar {
            height: var(--topbar-h);
            background: var(--brand);
            color: #fff;
        }

            .topbar .brand {
                font-weight: 800;
                font-size: 1.6rem;
                letter-spacing: 1px;
                color: #fff;
                text-decoration: none;
            }

            .topbar .role-badge {
                background: rgba(255,255,255,.22);
                font-size: .72rem;
                font-weight: 700;
                padding: 4px 10px;
                border-radius: 999px;
                letter-spacing: .5px;
            }

            .topbar a.top-link {
                color: #fff;
                text-decoration: none;
            }

            .topbar .avatar {
                width: 36px;
                height: 36px;
                border-radius: 50%;
                background: rgba(255,255,255,.25);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
            }

        .layout {
            display: flex;
            min-height: calc(100vh - var(--topbar-h));
        }

        .sidebar {
            width: 250px;
            background: #fff;
            border-right: 1px solid #e5e7eb;
            padding: 14px 12px;
        }

            .sidebar .nav-link {
                color: #374151;
                padding: 11px 14px;
                border-radius: 8px;
                margin-bottom: 4px;
                font-weight: 500;
            }

                .sidebar .nav-link i {
                    width: 22px;
                    display: inline-block;
                }

                .sidebar .nav-link:hover {
                    background: #f3f4f6;
                }

                .sidebar .nav-link.active {
                    background: var(--brand-soft);
                    color: var(--brand);
                }

        .content {
            flex: 1;
            min-width: 0;
            padding: 24px 28px;
        }

        .stat-card {
            border: 0;
            border-radius: 14px;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
        }

        .stat-icon {
            width: 64px;
            height: 64px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.7rem;
            flex-shrink: 0;
        }

            .stat-icon.green {
                background: #e6f4ec;
                color: #188a5a;
            }

            .stat-icon.blue {
                background: #e7efff;
                color: #2563eb;
            }

            .stat-icon.orange {
                background: #fff1e0;
                color: #ea7a0c;
            }

            .stat-icon.purple {
                background: #f1e9ff;
                color: #7c3aed;
            }

            .stat-icon.yellow {
                background: #fdf3d4;
                color: #b7791f;
            }

            .stat-icon.teal {
                background: #dff5f3;
                color: #0d9488;
            }
    </style>
</head>
<body>
    <header class="topbar d-flex justify-content-between align-items-center px-4">
        <div class="d-flex align-items-center gap-3">
            <a class="brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">DOTJOB</a>
            <span class="role-badge">QUẢN TRỊ</span>
        </div>
        <div class="d-flex align-items-center gap-4">
            <a class="top-link" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door-fill me-1"></i>Trang chủ
            </a>
            <div class="d-flex align-items-center gap-2">
                <span class="avatar">@initial</span>
                <span>@email</span>
            </div>
            <form method="post" asp-area="" asp-controller="Auth" asp-action="Logout" class="m-0">
                <button type="submit" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                </button>
            </form>
        </div>
    </header>

    <div class="layout">
        <nav class="sidebar">
            <ul class="nav flex-column">
                <li>
                    <a class="nav-link @(controller == "Dashboard" ? "active" : "")"
                       asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-graph-up"></i>Tổng quan
                    </a>
                </li>
                <li>
                    <a class="nav-link @(controller == "Category" ? "active" : "")"
                       asp-area="Admin" asp-controller="Category" asp-action="Index">
                        <i class="bi bi-tags"></i>Danh mục ngành nghề
                    </a>
                </li>
                <li>
                    <a class="nav-link @(controller == "User" ? "active" : "")"
                       asp-area="Admin" asp-controller="User" asp-action="Index">
                        <i class="bi bi-people"></i>Người dùng
                    </a>
                </li>
                <li>
                    <a class="nav-link @(controller == "Report" ? "active" : "")"
                       asp-area="Admin" asp-controller="Report" asp-action="Index">
                        <i class="bi bi-flag"></i>Báo cáo
                    </a>
                </li>
            </ul>
        </nav>

        <main class="content">
            <h4 class="mb-4 fw-bold">@ViewData["Title"]</h4>
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>